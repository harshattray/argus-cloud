{
  "threshold": 0.5,
  "app": {
    "baseUrl": "http://localhost:5173"
  },
  "frames": [
    {
      "label": "Norma — Hero",
      "screenshot": "norma-hero.png",
      "mode": "baseline",
      "route": "/@norma",
      "capture": "viewport",
      "viewport": {
        "width": 1440,
        "height": 1000
      },
      "waitMs": 2500
    },
    {
      "label": "Norma — Engine",
      "screenshot": "norma-engine.png",
      "mode": "baseline",
      "route": "/@norma",
