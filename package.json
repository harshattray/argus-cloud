{
  "name": "argus-cloud",
  "version": "0.1.0",
  "description": "Normascope Cloud — hosted service (private)",
  "main": "dist/db.js",
  "exports": {
    "./*": "./dist/*"
  },
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "workspaces": [
    "web"
  ],
  "scripts": {
    "test": "npm run build && node test/metering.test.mjs && node test/enrichment.test.mjs && node test/cibatch.test.mjs",
    "build": "tsc",
    "build:web": "npm run build && npm run build --workspace web",
    "dev:web": "npm run build && npm run dev --workspace web"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harshattray/argus-cloud.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/harshattray/argus-cloud/issues"
  },
  "homepage": "https://github.com/harshattray/argus-cloud#readme",
  "private": "true",
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "pg": "^8.22.0"
  }
}
