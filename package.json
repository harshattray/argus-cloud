{
  "name": "argus-cloud",
  "version": "0.1.0",
  "description": "Normascope Cloud — hosted service (private)",
  "main": "dist/db.js",
  "exports": {
    "./*": "./dist/*"
  },
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "workspaces": [
    "web"
  ],
  "scripts": {
    "test": "npm run build && node scripts/run-tests.mjs",
    "build": "node scripts/embed-migrations.mjs && node scripts/embed-legal.mjs && tsc",
    "typecheck:web": "npm run build && npm run typecheck --workspace web",
    "audit": "node scripts/audit-check.mjs",
    "verify": "npm run build && npm run typecheck:web && npm test && npm run build --workspace web && npm run audit",
    "backup": "npm run build && node scripts/backup.mjs",
    "rehearse-restore": "npm run build && node scripts/restore-rehearsal.mjs",
    "ops-check": "npm run build && node scripts/ops-check.mjs",
    "build:web": "npm run build && npm run build --workspace web",
    "dev:web": "npm run build && npm run dev --workspace web",
    "sweep-uploads": "npm run build && node scripts/sweep-uploads.mjs",
    "seed:dev": "npm run build && node scripts/seed-dev.mjs",
    "schema-drift": "npm run build && node scripts/schema-drift.mjs",
    "adopt-schema": "npm run build && node scripts/adopt-schema.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harshattray/argus-cloud.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/harshattray/argus-cloud/issues"
  },
  "homepage": "https://github.com/harshattray/argus-cloud#readme",
  "private": "true",
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@aws-sdk/s3-request-presigner": "^3.1106.0",
    "@electric-sql/pglite": "^0.5.4",
    "pg": "^8.22.0"
  }
}
